# ─────────────────────────────────────────────────────────────────────────────
# Isabella's Alerts — local environment template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and never committed.
# In GitHub Actions these are stored as repository secrets instead.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Anthropic API key (used by src/curate.js)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required for email sending: Resend API key (used by src/send-alert.js)
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Comma-separated list of recipient email addresses
# In production this is set as a GitHub Actions secret (ALERT_RECIPIENTS)
ALERT_RECIPIENTS=you@example.com
